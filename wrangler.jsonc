{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trptools-frontend",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_als"],
  "minify": true,
  "keep_vars": true,
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "services": [
    {
      "binding": "BACKEND",
      "service": "trptools-backend"
    }
  ],
  "env": {
    "local": {
      "name": "trptools-frontend-local",
      "services": []
    }
  }
}
