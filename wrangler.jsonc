{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trptools-frontend",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_als"],
  "minify": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  }
}
