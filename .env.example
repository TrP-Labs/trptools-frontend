# Origin of the TrPTools API. Read at runtime, so a container can be pointed at
# a different backend without rebuilding.
PUBLIC_API_URL=http://localhost:3001

# Origin used by server-side rendering. Defaults to PUBLIC_API_URL, which is
# correct outside containers. On a container network set it to the backend's
# service name, e.g. http://backend:3001
# INTERNAL_API_URL=

# Repository whose root files become the footer bar. `.md` is served at
# /policies/<slug>; `.txt` holds a URL. The public TrP-Labs repository needs no
# token. A token can be supplied for a private fork or higher GitHub API quota.
POLICIES_REPOSITORY=TrP-Labs/Policies
POLICIES_REF=main
POLICIES_CACHE_SECONDS=300
# POLICIES_GITHUB_TOKEN=
