# Origin of the TrPTools API. Read at runtime, so a container can be pointed at
# a different backend without rebuilding.
PUBLIC_API_URL=http://localhost:3001

# Origin used by server-side rendering. Defaults to PUBLIC_API_URL, which is
# correct outside containers. On a container network set it to the backend's
# service name, e.g. http://backend:3001
# INTERNAL_API_URL=

# Directory whose files become the footer bar, read at startup (not baked into
# the build). A file's name minus its extension is the link's label: `.md` is a
# document served at /policies/<slug>, `.txt` holds a single URL to link
# straight to. Defaults to ./policies. In Docker this is a volume mount.
# POLICIES_DIR=../trptools-terms/Policies
