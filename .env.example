# Origin of the TrPTools API. Read at runtime, so a container can be pointed at
# a different backend without rebuilding.
PUBLIC_API_URL=http://localhost:3001

# Origin used by server-side rendering. Defaults to PUBLIC_API_URL, which is
# correct outside containers. On a container network set it to the backend's
# service name, e.g. http://backend:3001
# INTERNAL_API_URL=

# Directory containing TERMS.md and PRIVACY.md, read at startup (not baked
# into the build). Defaults to ./policies. In Docker this is a volume mount;
# outside Docker point it at wherever you keep those files. Missing files just
# mean no terms/privacy pages.
# POLICIES_DIR=./policies
